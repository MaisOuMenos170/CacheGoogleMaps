# Google Places API Key
# Obtenha no Google Cloud Console com as APIs "Places API" e "Places API (New)" habilitadas.
GOOGLE_PLACES_API_KEY=sua_chave_google_places_aqui

# GitHub Personal Access Token (Fine-grained com permissão 'Contents: Read and write' no repositório)
GITHUB_TOKEN=seu_github_pat_aqui

# Configurações do Repositório GitHub onde o catálogo será salvo
GITHUB_OWNER=MaisOuMenos170
GITHUB_REPO=CacheGoogleMaps
GITHUB_BRANCH=main
GITHUB_FILE_PATH=data/lugares.json
